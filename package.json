{
  "name": "@boppl/icons",
  "version": "1.2.1",
  "description": "This is a collection of icons used at Bopple.",
  "license": "UNLICENSED",
  "author": "Bopple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boppl/icons.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "release": "./scripts/release.sh",
    "changelog": "bash -c 'source scripts/changelog.sh; generate_changelog \"$1\"' --",
    "version": "npm run changelog \"$npm_package_version\" && git add CHANGELOG.md",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*": "./dist/*"
  }
}
