{
  "name": "@boppl/icons",
  "version": "2.0.0",
  "description": "This is a collection of icons used at Bopple.",
  "license": "UNLICENSED",
  "author": "Bopple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boppl/icons.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./react/*": {
      "types": "./dist/react/*/index.d.ts",
      "default": "./dist/react/*/index.js"
    },
    "./*": "./dist/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "release": "./scripts/release.sh",
    "changelog": "bash -c 'source scripts/changelog.sh; generate_changelog \"$1\"' --",
    "version": "npm run changelog \"$npm_package_version\" && git add CHANGELOG.md",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "esbuild": "0.28.2",
    "svgo": "4.1.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
